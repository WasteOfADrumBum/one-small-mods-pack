{
  "$schema": "./schema/modspack.schema.json",
  "quality": {
    "required": [
      "typecheck",
      "test",
      "build"
    ],
    "scripts": {
      "typecheck": [
        "typecheck:cli"
      ],
      "test": [
        "test:all"
      ]
    }
  },
  "release": {
    "requiredGates": [
      "quality",
      "security",
      "privacy",
      "accessibility",
      "package"
    ]
  }
}
