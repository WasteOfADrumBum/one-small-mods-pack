{
  "enabled": true,
  "tokensFile": "design-tokens.json",
  "extensions": [
    ".css",
    ".scss",
    ".sass",
    ".less",
    ".tsx",
    ".jsx",
    ".vue",
    ".html",
    ".svelte",
    ".astro"
  ],
  "ignore": [
    "**/*.stories.tsx",
    "legacy/**"
  ],
  "allow": [
    "0",
    "0px"
  ],
  "maxReported": 20,
  "allowSvgColors": true,
  "blockBashWrites": true,
  "watchBash": true
}
